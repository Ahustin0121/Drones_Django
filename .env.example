# ==========================================================================
# AeroVigía · Variables de entorno
# Copia este archivo como .env y completa los valores necesarios.
# ==========================================================================

# --- Núcleo Django ---------------------------------------------------------
# En producción usa una clave larga y aleatoria (mínimo 50 caracteres).
SECRET_KEY=django-insecure-solo-para-desarrollo-local-cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---------------------------------------------------------
# Sin DATABASE_URL se usa SQLite (desarrollo local).
# En producción Render entrega esta URL automáticamente.
# DATABASE_URL=postgresql://usuario:clave@host:5432/aerovigia
DB_SSL_REQUIRE=False

# --- Cloudflare R2 ---------------------------------------------------------
# Si estas cuatro variables están completas, los videos se suben directo a R2.
# Si están vacías, se usa el almacenamiento local (solo desarrollo).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRESIGN_EXPIRES=3600
R2_VIDEO_RETENTION_DAYS=60

# Tamaño máximo aceptado por la subida local de respaldo (bytes).
VIDEO_LOCAL_MAX_BYTES=1073741824

# --- Seguridad en producción ----------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Render ----------------------------------------------------------------
# Activa la carga de datos de demostración solo si lo necesitas.
# SEED_DEMO=False
